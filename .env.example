# Local Postgres. `docker compose up -d` creates this user and database.
DATABASE_URL=postgresql://glossy:glossy@localhost:5432/glossy
# Used only by automated tests. Never point this at the live database.
TEST_DATABASE_URL=postgresql://glossy:glossy@localhost:5432/glossy_test

# Generate a long random value. Never commit the real .env file.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public site origin. Verification and password-reset links use this value.
# Local development uses the port the app is running on. Production must be the public https origin.
# A missing value stops the app. In production, a localhost link is not sent.
BETTER_AUTH_URL=http://localhost:3001

# Used only by `npm run db:seed` to create the first admin. Signup cannot grant this role.
ADMIN_EMAIL=admin@glossy.local
ADMIN_NAME=مديرة المتجر
ADMIN_PASSWORD=replace-with-a-long-password

# Required in production. Placeholder only — create a sending-only key in Resend. Never commit the real key.
RESEND_API_KEY=re_replace_with_a_sending_only_key
# Must use a verified Resend domain. Placeholder only.
EMAIL_FROM=Glossy <orders@example.com>

# Required in production. Local development stores uploads in public/uploads when these are empty.
# Production refuses to start, and refuses to save images, until all five are set.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Optional. Leave empty until the client creates a Meta Pixel and agrees to consent.
# The shop does not load Meta when this is empty, and tests must not set a real ID.
META_PIXEL_ID=

# Optional development preview through one Cloudflare quick tunnel.
# Hostnames only, comma-separated. No scheme, port, or wildcard. Restart `next dev` after changing this.
# Example: doors-example.trycloudflare.com
ALLOWED_DEV_ORIGINS=
# Exact origins for Better Auth during development, comma-separated. Ignored in production.
# Example: https://doors-example.trycloudflare.com
AUTH_TRUSTED_ORIGINS=
